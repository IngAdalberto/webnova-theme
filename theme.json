{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        { "slug": "xs", "size": "0.5rem", "name": "Extra Small" },
        { "slug": "sm", "size": "1rem", "name": "Small" },
        { "slug": "md", "size": "1.5rem", "name": "Medium" },
        { "slug": "lg", "size": "2rem", "name": "Large" },
        { "slug": "xl", "size": "3rem", "name": "Extra Large" },
        { "slug": "2xl", "size": "4rem", "name": "2XL" },
        { "slug": "3xl", "size": "6rem", "name": "3XL" }
      ]
    },
    "layout": {
      "contentSize": "840px",
      "wideSize": "1200px"
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "palette": [
        { "slug": "primary", "color": "#061B4A", "name": "Primary" },
        { "slug": "primary-dark", "color": "#041233", "name": "Primary Dark" },
        { "slug": "primary-light", "color": "#1E3A8A", "name": "Primary Light" },
        { "slug": "accent", "color": "#EB472A", "name": "Accent" },
        { "slug": "accent-dark", "color": "#C83218", "name": "Accent Dark" },
        { "slug": "accent-light", "color": "#F27A65", "name": "Accent Light" },
        { "slug": "background", "color": "#FFFFFF", "name": "Background" },
        { "slug": "surface", "color": "#F9FAFB", "name": "Surface" },
        { "slug": "surface-alt", "color": "#F3F4F6", "name": "Surface Alt" },
        { "slug": "text", "color": "#1F2937", "name": "Text" },
        { "slug": "text-muted", "color": "#6B7280", "name": "Text Muted" },
        { "slug": "border", "color": "#E5E7EB", "name": "Border" },
        { "slug": "success", "color": "#2E7D32", "name": "Success" },
        { "slug": "warning", "color": "#F59E0B", "name": "Warning" },
        { "slug": "error", "color": "#DC2626", "name": "Error" },
        { "slug": "info", "color": "#3B82F6", "name": "Info" },
        { "slug": "webnova-primary", "color": "#061B4A", "name": "WebNova Primary (Legacy)" },
        { "slug": "webnova-secondary", "color": "#EB472A", "name": "WebNova Secondary (Legacy)" },
        { "slug": "webnova-accent", "color": "#EB472A", "name": "WebNova Accent (Legacy)" },
        { "slug": "webnova-text", "color": "#1F2937", "name": "WebNova Text (Legacy)" },
        { "slug": "webnova-soft", "color": "#F9FAFB", "name": "WebNova Soft (Legacy)" },
        { "slug": "webnova-surface", "color": "#FFFFFF", "name": "WebNova Surface (Legacy)" },
        { "slug": "webnova-muted", "color": "#6B7280", "name": "WebNova Muted (Legacy)" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "Inter, system-ui, -apple-system, sans-serif"
        },
        {
          "slug": "heading",
          "name": "Heading",
          "fontFamily": "Inter, system-ui, -apple-system, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "size": "0.75rem", "name": "Extra Small" },
        { "slug": "sm", "size": "0.875rem", "name": "Small" },
        { "slug": "md", "size": "1rem", "name": "Medium" },
        { "slug": "lg", "size": "1.125rem", "name": "Large" },
        { "slug": "xl", "size": "1.25rem", "name": "Extra Large" },
        { "slug": "2xl", "size": "1.5rem", "name": "2XL" },
        { "slug": "3xl", "size": "1.875rem", "name": "3XL" },
        { "slug": "4xl", "size": "2.25rem", "name": "4XL" },
        { "slug": "5xl", "size": "3rem", "name": "5XL" },
        { "slug": "small", "size": "0.875rem", "name": "Small (Legacy)" },
        { "slug": "medium", "size": "1rem", "name": "Medium (Legacy)" },
        { "slug": "large", "size": "1.25rem", "name": "Large (Legacy)" },
        { "slug": "x-large", "size": "1.5rem", "name": "Extra Large (Legacy)" },
        { "slug": "hero", "size": "clamp(2.4rem, 5vw, 4.5rem)", "name": "Hero (Legacy)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "24px",
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--xl)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--xl)"
      }
    },
    "elements": {
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--background)"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "20px",
            "bottom": "12px",
            "left": "20px"
          }
        },
        "typography": {
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "800",
          "lineHeight": "1.15"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "landing-colegios",
      "postTypes": ["page"],
      "title": "Landing Colegios (Comercial)"
    }
  ]
}
